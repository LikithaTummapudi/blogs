---
import BaseLayout from '@layouts/BaseLayout.astro';
import { siteConfig } from '@config/site';
---

<BaseLayout
  title="About — Likitha Tummapudi"
  description="Hi, I'm Likitha Tummapudi, a B.Tech student who enjoys building software, solving problems, and exploring how technology can be used to create practical solutions."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-10 flex items-center gap-2 text-xs font-mono text-charcoal-500">
      <a href="/" class="hover:text-charcoal-900 transition-colors">Home</a>
      <span>/</span>
      <span class="text-terracotta-700 font-semibold">About</span>
    </nav>

    <!-- Page Header -->
    <header class="mb-8 sm:mb-9">
      <div class="inline-flex items-center gap-1.5 text-[10.5px] font-mono font-semibold tracking-widest uppercase text-terracotta-700/90 bg-terracotta-50/70 border border-terracotta-200/70 px-2.5 py-0.5 rounded-full mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-terracotta-600"></span>
        Editorial Profile
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-[42px] font-bold tracking-tight text-charcoal-950 mb-1.5 leading-tight">
        About Likitha Tummapudi
      </h1>
      <p class="font-serif text-base sm:text-lg text-terracotta-700 italic font-normal mt-0">
        A curious mind, a builder at heart.
      </p>
    </header>

    <!-- Hero Introduction with Profile Illustration -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-16 pb-12 border-b border-parchment-200">
      <!-- Main Four Introduction Paragraphs -->
      <div class="lg:col-span-7 font-sans text-charcoal-700 text-[15.5px] sm:text-base leading-[1.75] space-y-4 sm:space-y-4.5 max-w-xl">
        <p>
          <span class="text-terracotta-700 font-semibold">Hi,</span> I'm Likitha Tummapudi, a B.Tech student who enjoys building software, solving problems, and exploring how technology can be used to create practical solutions. I was initially drawn to programming through Java and Data Structures &amp; Algorithms, and over time, I became increasingly interested in developing complete applications rather than just solving coding problems.
        </p>

        <p>
          I've worked on projects in Machine Learning and Full-Stack Development, which taught me how to turn ideas into working solutions and approach problems from different perspectives. I've also contributed to open-source projects through GirlScript Summer of Code (GSSoC), where I experienced collaborative software development firsthand—working with Git, reviewing feedback, and improving code through pull requests.
        </p>

        <p>
          My interests extend beyond software development into Artificial Intelligence, Data Science, and Quantum Computing. I enjoy exploring unfamiliar concepts, understanding the ideas behind new technologies, and experimenting with them through hands-on projects.
        </p>

        <p>
          What I enjoy most is learning by building. I value collaboration, exchanging ideas, and learning from people with different perspectives. I believe every project and challenge offers an opportunity to improve, and I'm always looking forward to exploring something new, creating meaningful things, and growing as a developer.
        </p>
      </div>

      <!-- Workspace Illustration: Cozy Creative Still Life Vignette -->
      <div class="lg:col-span-5 flex flex-col items-center lg:items-end w-full">
        <div class="w-full max-w-[320px] sm:max-w-[340px] p-3 bg-white rounded-2xl border border-parchment-300 shadow-sm">
          <div class="w-full aspect-square rounded-xl overflow-hidden bg-parchment-100 flex items-center justify-center border border-parchment-200">
            <img
              src="/images/about-illustration.svg"
              alt="Hand-drawn editorial illustration of a cozy creative workspace with laptop, books, and plants"
              class="w-full h-full object-contain select-none"
              loading="eager"
              width="400"
              height="400"
            />
          </div>

          <!-- Subtle Caption -->
          <div class="mt-3 pb-0.5 text-center">
            <span class="font-serif font-semibold text-xs text-charcoal-900 block">
              Creative Workspace
            </span>
            <span class="text-[10.5px] font-mono text-charcoal-500 block mt-0.5">
              Code &bull; Notes &bull; Continuous Learning
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial Narrative Sections -->
    <div class="space-y-20">
      <!-- Section 1: A little about my journey -->
      <section class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        <div class="md:col-span-4">
          <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-charcoal-500 mb-2">
            <span class="text-terracotta-600 font-bold">01</span>
            Evolution
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal-950">
            A little about my journey
          </h2>
        </div>

        <div class="md:col-span-8 font-sans text-charcoal-700 text-base sm:text-lg leading-relaxed space-y-5">
          <p>
            My pathway into computer science started with the precision of Java and the algorithmic rhythm of Data Structures. Writing clean loops, analyzing time complexities, and decomposing problems piece by piece built my foundation. But as I solved more isolated challenges, a natural curiosity emerged: <em class="font-serif text-charcoal-950">how do these discrete algorithms connect to build software that real people interact with every day?</em>
          </p>
          <p>
            That curiosity sparked my transition into building complete full-stack web applications and experimenting with Machine Learning models. Instead of simply writing code for test cases, I began constructing interfaces, managing data flow, handling edge cases, and experiencing the satisfaction of watching an abstract idea transform into a responsive, functioning tool.
          </p>
          <p>
            A defining milestone in this journey was contributing to open-source software through GirlScript Summer of Code (GSSoC). Immersing myself in public repositories showed me the genuine art of engineering: understanding legacy architectures, communicating through transparent pull requests, integrating constructive peer reviews, and refining code for stability and collective ownership.
          </p>
        </div>
      </section>

      <!-- Section Divider -->
      <div class="w-full h-px bg-parchment-200"></div>

      <!-- Section 2: Things that interest me -->
      <section class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        <div class="md:col-span-4">
          <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-charcoal-500 mb-2">
            <span class="text-terracotta-600 font-bold">02</span>
            Curiosities
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal-950">
            Things that interest me
          </h2>
          <p class="text-xs font-mono text-charcoal-500 mt-2">
            Core disciplines where I focus my reading, experiments, and writing.
          </p>
        </div>

        <div class="md:col-span-8 space-y-4">
          <!-- Item 1: Artificial Intelligence -->
          <div class="p-6 rounded-2xl bg-white border border-parchment-300 hover:border-terracotta-300 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-serif text-xl font-bold text-charcoal-950">
                Artificial Intelligence
              </h3>
              <span class="text-xs font-mono uppercase px-2.5 py-0.5 rounded-full bg-parchment-100 text-charcoal-700 font-medium">
                Exploration
              </span>
            </div>
            <p class="font-sans text-sm sm:text-base text-charcoal-600 leading-relaxed">
              Investigating deep learning architectures, transformer attention mechanisms, and how intelligent models synthesize complex representations from unstructured information.
            </p>
          </div>

          <!-- Item 2: Data Science -->
          <div class="p-6 rounded-2xl bg-white border border-parchment-300 hover:border-terracotta-300 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-serif text-xl font-bold text-charcoal-950">
                Data Science &amp; Predictive Modeling
              </h3>
              <span class="text-xs font-mono uppercase px-2.5 py-0.5 rounded-full bg-parchment-100 text-charcoal-700 font-medium">
                Analysis
              </span>
            </div>
            <p class="font-sans text-sm sm:text-base text-charcoal-600 leading-relaxed">
              Extracting meaningful signals from noisy data, crafting predictive regression and classification pipelines, and using statistical rigor to inform decisions.
            </p>
          </div>

          <!-- Item 3: Quantum Computing -->
          <div class="p-6 rounded-2xl bg-white border border-parchment-300 hover:border-terracotta-300 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-serif text-xl font-bold text-charcoal-950">
                Quantum Computing
              </h3>
              <span class="text-xs font-mono uppercase px-2.5 py-0.5 rounded-full bg-parchment-100 text-charcoal-700 font-medium">
                Frontier
              </span>
            </div>
            <p class="font-sans text-sm sm:text-base text-charcoal-600 leading-relaxed">
              Fascinated by non-classical computation, superposition, entanglement, and computational simulations that challenge our fundamental understanding of information.
            </p>
          </div>

          <!-- Item 4: Software Development -->
          <div class="p-6 rounded-2xl bg-white border border-parchment-300 hover:border-terracotta-300 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-serif text-xl font-bold text-charcoal-950">
                Software Development
              </h3>
              <span class="text-xs font-mono uppercase px-2.5 py-0.5 rounded-full bg-parchment-100 text-charcoal-700 font-medium">
                Architecture
              </span>
            </div>
            <p class="font-sans text-sm sm:text-base text-charcoal-600 leading-relaxed">
              Designing modular, resilient web applications with a focus on code readability, solid design patterns, performance, and accessible user experiences.
            </p>
          </div>
        </div>
      </section>

      <!-- Section Divider -->
      <div class="w-full h-px bg-parchment-200"></div>

      <!-- Section 3: Beyond the screen -->
      <section class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        <div class="md:col-span-4">
          <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-charcoal-500 mb-2">
            <span class="text-terracotta-600 font-bold">03</span>
            Perspective
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal-950">
            Beyond the screen
          </h2>
        </div>

        <div class="md:col-span-8 font-sans text-charcoal-700 text-base sm:text-lg leading-relaxed space-y-6">
          <p>
            For me, technology is at its best when it remains human. Writing code is deeply rewarding, but the joy truly multiplies when ideas are shared openly, challenged constructively, and refined through dialogue with mentors and peers.
          </p>
          <p>
            I approach every project not merely as a technical deliverable, but as an experiment in learning. When a model fails to converge or an unexpected runtime bug surfaces, it isn't a setback—it is an invitation to understand the system more deeply. I value the craft of quiet perseverance, the excitement of unraveling complex concepts, and the continuous journey of improvement.
          </p>

          <!-- Highlight Statement -->
          <div class="my-8 py-8 px-8 rounded-2xl bg-white border border-parchment-300 shadow-2xs text-center md:text-left">
            <span class="text-xs font-mono uppercase tracking-widest text-terracotta-700 font-semibold block mb-3">
              Personal Motto
            </span>
            <p class="font-serif text-2xl sm:text-3xl lg:text-4xl font-normal text-charcoal-950 leading-snug">
              &ldquo;Always curious. Always building. Always becoming.&rdquo;
            </p>
          </div>
        </div>
      </section>

      <!-- Understated Contact & Social Strip -->
      <section class="pt-10 border-t border-parchment-200">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 p-8 rounded-2xl bg-white border border-parchment-300 shadow-2xs">
          <div>
            <h3 class="font-serif text-2xl font-bold text-charcoal-950 mb-1">
              Let's connect
            </h3>
            <p class="text-sm font-sans text-charcoal-600">
              Open to conversations on technology, learning, and collaborative ideas.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2.5 rounded-xl bg-parchment-100 hover:bg-parchment-200 text-charcoal-800 text-xs font-mono font-medium transition-colors flex items-center gap-2 border border-parchment-300"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              GitHub
            </a>

            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2.5 rounded-xl bg-parchment-100 hover:bg-parchment-200 text-charcoal-800 text-xs font-mono font-medium transition-colors flex items-center gap-2 border border-parchment-300"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              LinkedIn
            </a>

            <a
              href={`mailto:${siteConfig.author.email}`}
              class="px-4 py-2.5 rounded-xl bg-charcoal-900 hover:bg-terracotta-600 text-parchment-50 text-xs font-mono font-medium transition-colors flex items-center gap-2 shadow-2xs"
            >
              <svg class="w-4 h-4 fill-none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Say Hello
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
