---
import BaseLayout from '@layouts/BaseLayout.astro';
import { siteConfig } from '@config/site';
---

<BaseLayout
  title={`About — ${siteConfig.author.name}`}
  description={`Background, technical interests, learning roadmap, and writing philosophy of ${siteConfig.author.name}.`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center gap-2 text-xs font-mono text-charcoal-500">
      <a href="/" class="hover:text-charcoal-900">Home</a>
      <span>/</span>
      <span class="text-terracotta-700 font-semibold">About</span>
    </nav>

    <!-- Page Header & Bio Hero -->
    <header class="pb-12 border-b border-parchment-200">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8">
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-terracotta-700 bg-terracotta-50 border border-terracotta-200 px-3 py-1 rounded-full mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-terracotta-600"></span>
            Author Biography &amp; Journal Manifesto
          </div>
          <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-charcoal-950 mb-4">
            Hello, I'm {siteConfig.author.name}.
          </h1>
          <p class="text-lg text-charcoal-600 font-sans leading-relaxed">
            {siteConfig.author.role} based in {siteConfig.author.location}. This publication is my public learning laboratory—a weekly commitment to distill computer science concepts, explore systems architectures, and write with rigorous technical clarity.
          </p>
        </div>

        <div class="md:col-span-4 flex justify-center md:justify-end">
          <div class="relative p-2 bg-white rounded-2xl border border-parchment-300 shadow-sm">
            <img
              src={siteConfig.author.avatar}
              alt={siteConfig.author.name}
              class="w-40 h-40 rounded-xl object-cover bg-parchment-100"
            />
            <div class="mt-3 text-center">
              <span class="text-xs font-mono font-medium text-charcoal-600 block">
                {siteConfig.author.name}
              </span>
              <span class="text-[11px] font-mono text-terracotta-700 block">
                Writing Every Sunday
              </span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Content Sections -->
    <div class="mt-12 space-y-16">
      <!-- 1. Introduction -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">01</span>
          Introduction
        </h2>
        <div class="prose prose-charcoal max-w-none text-charcoal-700 leading-relaxed space-y-4">
          <p>
            I am a software engineer and computer science student with a deep fascination for how software systems work beneath high-level abstractions. Whether it is understanding memory layouts and zero-cost abstractions, dissecting attention matrices in modern neural networks, or analyzing distributed consensus protocols, I believe the best way to master a subject is to deconstruct it and explain it simply.
          </p>
          <p>
            This website serves as my primary technical journal. My mentor visits weekly to inspect my publications, critique my architectural thinking, and track my progress. I have built this site to uphold the highest standard of craftsmanship, readability, and intellectual honesty.
          </p>
        </div>
      </section>

      <!-- 2. Academic Background -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">02</span>
          Academic Background
        </h2>
        <div class="p-6 rounded-xl bg-white border border-parchment-300 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <h3 class="font-serif font-bold text-lg text-charcoal-950">
              {siteConfig.author.academic}
            </h3>
            <span class="text-xs font-mono text-charcoal-500 bg-parchment-100 px-2.5 py-1 rounded">
              Undergraduate Degree [Year &bull; Institution Placeholder]
            </span>
          </div>
          <p class="text-sm text-charcoal-600 leading-relaxed">
            Core Coursework: Data Structures &amp; Algorithms, Computer Systems Architecture, Operating Systems Internals, Database Management Systems, Theory of Computation, and Computer Networks.
          </p>
        </div>
      </section>

      <!-- 3. Technical Interests & Areas I Enjoy Exploring -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">03</span>
          Technical Interests &amp; Focus Areas
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-white border border-parchment-300">
            <div class="w-8 h-8 rounded-lg bg-terracotta-50 text-terracotta-600 flex items-center justify-center font-bold text-sm mb-3">
              AI
            </div>
            <h3 class="font-serif font-bold text-base text-charcoal-900 mb-1">
              Deep Learning &amp; AI Fundamentals
            </h3>
            <p class="text-xs text-charcoal-600 leading-relaxed">
              Transformer architectures, tokenization mechanics, attention optimization techniques (FlashAttention), and fine-tuning open-weights models.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-white border border-parchment-300">
            <div class="w-8 h-8 rounded-lg bg-sage-50 text-sage-600 flex items-center justify-center font-bold text-sm mb-3">
              SYS
            </div>
            <h3 class="font-serif font-bold text-base text-charcoal-900 mb-1">
              Systems Programming &amp; Memory
            </h3>
            <p class="text-xs text-charcoal-600 leading-relaxed">
              Rust ownership semantics, concurrency without data races, POSIX system calls, cache locality, and asynchronous I/O models.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-white border border-parchment-300">
            <div class="w-8 h-8 rounded-lg bg-amberGold-50 text-amberGold-600 flex items-center justify-center font-bold text-sm mb-3">
              API
            </div>
            <h3 class="font-serif font-bold text-base text-charcoal-900 mb-1">
              Resilient Backend Architecture
            </h3>
            <p class="text-xs text-charcoal-600 leading-relaxed">
              Distributed transactions, idempotency patterns, circuit breakers, event-driven messaging, and high-availability database replication.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-white border border-parchment-300">
            <div class="w-8 h-8 rounded-lg bg-parchment-200 text-charcoal-700 flex items-center justify-center font-bold text-sm mb-3">
              WEB
            </div>
            <h3 class="font-serif font-bold text-base text-charcoal-900 mb-1">
              Pragmatic Frontend Engineering
            </h3>
            <p class="text-xs text-charcoal-600 leading-relaxed">
              Static site generation, accessible component systems, performance budgets, minimal runtime JS footprints, and typographic excellence.
            </p>
          </div>
        </div>
      </section>

      <!-- 4. What I am Currently Learning -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">04</span>
          Current Learning Roadmap
        </h2>
        <div class="p-6 rounded-xl bg-white border border-parchment-300 space-y-4">
          <p class="text-sm text-charcoal-600">
            My active weekly study tracks for this quarter:
          </p>
          <ul class="space-y-3 text-sm text-charcoal-700">
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-sage-100 text-sage-700 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">
                1
              </span>
              <div>
                <strong class="font-medium text-charcoal-900">Distributed Consensus Algorithms:</strong>
                <span class="text-charcoal-600"> Studying the Raft and Paxos protocols by implementing a miniature leader election state machine.</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-terracotta-100 text-terracotta-700 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">
                2
              </span>
              <div>
                <strong class="font-medium text-charcoal-900">CUDA &amp; GPU Kernel Optimization:</strong>
                <span class="text-charcoal-600"> Understanding memory tiling, warp divergence, and shared memory coalescing for matrix multiplication kernels.</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-amberGold-100 text-amberGold-700 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">
                3
              </span>
              <div>
                <strong class="font-medium text-charcoal-900">Advanced Rust Async Runtimes:</strong>
                <span class="text-charcoal-600"> Deep dive into Tokio internals, epoll/kqueue event loops, and manual `Future` state machine pin projections.</span>
              </div>
            </li>
          </ul>
        </div>
      </section>

      <!-- 5. Why I Write Blogs -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">05</span>
          Why I Write
        </h2>
        <div class="prose prose-charcoal max-w-none text-charcoal-700 leading-relaxed space-y-4">
          <blockquote>
            "If you cannot explain a technical concept in plain English and implement a minimal reproducible prototype, you do not truly understand it yet."
          </blockquote>
          <p>
            Writing forces intellectual discipline. It exposes illusory clarity—those moments when you assume you understand an algorithm until you are forced to define the invariants on paper.
          </p>
          <p>
            By publishing weekly, I hold myself accountable to continuous exploration. Each article published here represents hours of reading whitepapers, running benchmarks, testing failure modes, and refining prose.
          </p>
        </div>
      </section>

      <!-- 6. Connect & Social Links -->
      <section class="pt-6 border-t border-parchment-200">
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4">
          Connect &amp; Collaborate
        </h2>
        <p class="text-sm text-charcoal-600 mb-6 leading-relaxed">
          I welcome questions, constructive peer critiques, mentor feedback, and interesting engineering conversations. You can find me across these channels:
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 rounded-xl bg-white border border-parchment-300 hover:border-terracotta-300 text-sm font-medium text-charcoal-800 hover:text-terracotta-700 transition-all flex items-center gap-2.5 shadow-2xs"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            GitHub
          </a>

          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 rounded-xl bg-white border border-parchment-300 hover:border-terracotta-300 text-sm font-medium text-charcoal-800 hover:text-terracotta-700 transition-all flex items-center gap-2.5 shadow-2xs"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn
          </a>

          <a
            href={`mailto:${siteConfig.author.email}`}
            class="px-5 py-3 rounded-xl bg-charcoal-900 hover:bg-terracotta-600 text-sm font-medium text-parchment-50 transition-all flex items-center gap-2.5 shadow-2xs"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Send Email
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
