---
import BaseLayout from '@layouts/BaseLayout.astro';
import { siteConfig } from '@config/site';
---

<BaseLayout
  title={`About — ${siteConfig.author.name}`}
  description={`Academic background, technical interests, projects, and learning journey of ${siteConfig.author.name}.`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center gap-2 text-xs font-mono text-charcoal-500">
      <a href="/" class="hover:text-charcoal-900">Home</a>
      <span>/</span>
      <span class="text-terracotta-700 font-semibold">About</span>
    </nav>

    <!-- Page Header & Bio Hero -->
    <header class="pb-12 border-b border-parchment-200">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8">
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-terracotta-700 bg-terracotta-50 border border-terracotta-200 px-3 py-1 rounded-full mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-terracotta-600"></span>
            About the Author
          </div>
          <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-charcoal-950 mb-4">
            Hello, I'm {siteConfig.author.name}.
          </h1>
          <p class="text-lg text-charcoal-600 font-sans leading-relaxed">
            I am a Computer Science student at VIT-AP University. I created this space to document what I learn, share hands-on software experiments, deconstruct challenging concepts, and keep a thoughtful record of my technical journey.
          </p>
        </div>

        <div class="md:col-span-4 flex justify-center md:justify-end">
          <div class="relative p-2 bg-white rounded-2xl border border-parchment-300 shadow-sm">
            <img
              src={siteConfig.author.avatar}
              alt={siteConfig.author.name}
              class="w-40 h-40 rounded-xl object-cover bg-parchment-100"
            />
            <div class="mt-3 text-center">
              <span class="text-xs font-mono font-medium text-charcoal-600 block">
                {siteConfig.author.name}
              </span>
              <span class="text-[11px] font-mono text-terracotta-700 block">
                VIT-AP University &bull; 2024–2028
              </span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Content Sections -->
    <div class="mt-12 space-y-16">
      <!-- 1. Personal Introduction -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">01</span>
          Introduction
        </h2>
        <div class="prose prose-charcoal max-w-none text-charcoal-700 leading-relaxed space-y-4">
          <p>
            I am currently pursuing my Bachelor of Technology in Computer Science and Engineering at VIT-AP University (Batch of 2024–2028), holding a current CGPA of 9.14.
          </p>
          <p>
            What excites me most about computer science is the process of taking abstract mathematical and algorithmic ideas and turning them into practical, functioning tools. Whether it involves experimenting with predictive machine learning models, exploring quantum circuits with Qiskit, or writing web applications that solve everyday challenges, I enjoy diving beneath the surface to understand how things work under the hood.
          </p>
          <p>
            My primary technical interests center on software development, artificial intelligence, machine learning, data science, and quantum computing. I consider myself a lifelong learner who values depth, consistency, and building software thoughtfully.
          </p>
        </div>
      </section>

      <!-- 2. Education -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">02</span>
          Education
        </h2>
        <div class="p-6 rounded-xl bg-white border border-parchment-300 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <h3 class="font-serif font-bold text-lg text-charcoal-950">
              Bachelor of Technology in Computer Science &amp; Engineering
            </h3>
            <span class="text-xs font-mono text-terracotta-700 bg-terracotta-50 border border-terracotta-200 px-2.5 py-1 rounded font-semibold">
              CGPA: 9.14
            </span>
          </div>
          <p class="text-sm font-medium text-charcoal-700">
            VIT-AP University, Andhra Pradesh
          </p>
          <p class="text-xs font-mono text-charcoal-500">
            Duration: 2024 – 2028
          </p>
          <p class="text-xs text-charcoal-600 leading-relaxed pt-1">
            Focus Areas: Data Structures and Algorithms, Object-Oriented Programming, Database Management Systems, Software Engineering, Probability &amp; Statistics, and Artificial Intelligence.
          </p>
        </div>
      </section>

      <!-- 3. Technical Interests & Skills -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">03</span>
          Technical Skills &amp; Focus Areas
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Group 1: Programming Languages -->
          <div class="p-5 rounded-xl bg-white border border-parchment-300">
            <div class="w-8 h-8 rounded-lg bg-terracotta-50 text-terracotta-600 flex items-center justify-center font-bold text-xs mb-3 font-mono">
              &lt;/&gt;
            </div>
            <h3 class="font-serif font-bold text-base text-charcoal-900 mb-2">
              Programming Languages
            </h3>
            <p class="text-xs text-charcoal-600 leading-relaxed mb-3">
              Core languages used for problem solving, algorithmic challenges, and application logic.
            </p>
            <div class="flex flex-wrap gap-1.5">
              {['Java', 'Python', 'C', 'C++', 'SQL', 'JavaScript'].map((skill) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-parchment-100 text-charcoal-700 border border-parchment-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <!-- Group 2: Data Science & ML -->
          <div class="p-5 rounded-xl bg-white border border-parchment-300">
            <div class="w-8 h-8 rounded-lg bg-sage-50 text-sage-600 flex items-center justify-center font-bold text-xs mb-3 font-mono">
              ML
            </div>
            <h3 class="font-serif font-bold text-base text-charcoal-900 mb-2">
              Data Science &amp; Machine Learning
            </h3>
            <p class="text-xs text-charcoal-600 leading-relaxed mb-3">
              Libraries and workflows for exploratory data analysis, feature engineering, and modeling.
            </p>
            <div class="flex flex-wrap gap-1.5">
              {['NumPy', 'Pandas', 'Matplotlib', 'Scikit-learn', 'Seaborn', 'Machine Learning'].map((skill) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-parchment-100 text-charcoal-700 border border-parchment-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <!-- Group 3: Computer Science Fundamentals -->
          <div class="p-5 rounded-xl bg-white border border-parchment-300">
            <div class="w-8 h-8 rounded-lg bg-amberGold-50 text-amberGold-600 flex items-center justify-center font-bold text-xs mb-3 font-mono">
              CS
            </div>
            <h3 class="font-serif font-bold text-base text-charcoal-900 mb-2">
              Computer Science Core
            </h3>
            <p class="text-xs text-charcoal-600 leading-relaxed mb-3">
              Theoretical foundations, software design principles, and data management.
            </p>
            <div class="flex flex-wrap gap-1.5">
              {['Data Structures & Algorithms', 'DBMS', 'Object-Oriented Programming', 'Software Engineering', 'Probability & Statistics'].map((skill) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-parchment-100 text-charcoal-700 border border-parchment-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <!-- Group 4: Emerging Tech, Web & Tools -->
          <div class="p-5 rounded-xl bg-white border border-parchment-300">
            <div class="w-8 h-8 rounded-lg bg-parchment-200 text-charcoal-700 flex items-center justify-center font-bold text-xs mb-3 font-mono">
              LAB
            </div>
            <h3 class="font-serif font-bold text-base text-charcoal-900 mb-2">
              Emerging Tech &amp; Tools
            </h3>
            <p class="text-xs text-charcoal-600 leading-relaxed mb-3">
              Quantum experimentation, backend frameworks, and engineering tooling.
            </p>
            <div class="flex flex-wrap gap-1.5">
              {['Artificial Intelligence', 'Quantum Computing', 'Qiskit', 'Flask', 'HTML/CSS', 'Git & GitHub', 'VS Code', 'Oracle SQL', 'Google Colab', 'Figma', 'Canva'].map((skill) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-parchment-100 text-charcoal-700 border border-parchment-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 4. Projects -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">04</span>
          Selected Projects
        </h2>
        <div class="space-y-4">
          <!-- Project 1 -->
          <div class="p-6 rounded-xl bg-white border border-parchment-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
              <h3 class="font-serif font-bold text-lg text-charcoal-950">
                AI Study Buddy
              </h3>
              <span class="text-xs font-mono text-terracotta-700 bg-terracotta-50 px-2.5 py-0.5 rounded border border-terracotta-200">
                Flask &bull; Google Gemini API &bull; Python
              </span>
            </div>
            <p class="text-sm text-charcoal-600 leading-relaxed">
              A web application designed to support students in their daily studies. Features include interactive topic explanations, intelligent note summarization, automated quiz generation, and digital flashcard creation for effective revision.
            </p>
          </div>

          <!-- Project 2 -->
          <div class="p-6 rounded-xl bg-white border border-parchment-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
              <h3 class="font-serif font-bold text-lg text-charcoal-950">
                Car Price Prediction
              </h3>
              <span class="text-xs font-mono text-sage-700 bg-sage-50 px-2.5 py-0.5 rounded border border-sage-200">
                Machine Learning &bull; Random Forest &bull; Scikit-learn
              </span>
            </div>
            <p class="text-sm text-charcoal-600 leading-relaxed">
              A predictive machine learning project utilizing historical vehicle listing data. Involves exploratory data analysis, data cleaning, feature encoding, and price estimation trained using ensemble methods including Random Forest regression.
            </p>
          </div>

          <!-- Project 3 -->
          <div class="p-6 rounded-xl bg-white border border-parchment-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
              <h3 class="font-serif font-bold text-lg text-charcoal-950">
                Income Classification
              </h3>
              <span class="text-xs font-mono text-amberGold-700 bg-amberGold-50 px-2.5 py-0.5 rounded border border-amberGold-200">
                Python &bull; Pandas &bull; Classification Algorithms
              </span>
            </div>
            <p class="text-sm text-charcoal-600 leading-relaxed">
              A supervised machine learning classification project involving structured demographic data preprocessing, handling class imbalances, feature scaling, and comparing multiple classifier baselines to predict income brackets.
            </p>
          </div>

          <!-- Project 4 -->
          <div class="p-6 rounded-xl bg-white border border-parchment-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
              <h3 class="font-serif font-bold text-lg text-charcoal-950">
                Quantum Teleportation Protocol
              </h3>
              <span class="text-xs font-mono text-charcoal-700 bg-parchment-100 px-2.5 py-0.5 rounded border border-parchment-300">
                Qiskit &bull; Quantum Computing &bull; Python
              </span>
            </div>
            <p class="text-sm text-charcoal-600 leading-relaxed">
              An implementation of the foundational quantum teleportation protocol using IBM's Qiskit framework, constructing quantum circuits with Bell states, entanglement, Hadamard gates, and measurement-based classical state reconstruction.
            </p>
          </div>

          <!-- Project 5 -->
          <div class="p-6 rounded-xl bg-white border border-parchment-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
              <h3 class="font-serif font-bold text-lg text-charcoal-950">
                Air Quality Prediction
              </h3>
              <span class="text-xs font-mono text-terracotta-700 bg-terracotta-50 px-2.5 py-0.5 rounded border border-terracotta-200">
                Flask &bull; Machine Learning &bull; Environmental Data
              </span>
            </div>
            <p class="text-sm text-charcoal-600 leading-relaxed">
              A Flask-based machine learning application that predicts air quality metrics using environmental parameters as inputs, providing a straightforward web interface to test model predictions.
            </p>
          </div>
        </div>
      </section>

      <!-- 5. Experience, Leadership & Open Source -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">05</span>
          Experience, Leadership &amp; Open Source
        </h2>
        <div class="space-y-4">
          <div class="p-6 rounded-xl bg-white border border-parchment-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
              <h3 class="font-serif font-bold text-base text-charcoal-950">
                CodeCrux — Former Tech Development Team Lead
              </h3>
              <span class="text-xs font-mono text-charcoal-500">
                Technical Leadership &amp; Collaboration
              </span>
            </div>
            <p class="text-xs text-charcoal-600 leading-relaxed">
              Previously served as a Tech Development Team Lead in the CodeCrux technical development team, participating in collaborative development activities, project coordination, and technical initiatives.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-white border border-parchment-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
              <h3 class="font-serif font-bold text-base text-charcoal-950">
                GirlScript Summer of Code (GSSoC 2026) — Open-Source Contributor
              </h3>
              <span class="text-xs font-mono text-terracotta-700">
                4 Merged Pull Requests &bull; EaseMotion-css
              </span>
            </div>
            <p class="text-xs text-charcoal-600 leading-relaxed">
              Contributed 4 merged pull requests to the EaseMotion-css repository during GirlScript Summer of Code 2026, gaining practical experience in open-source collaboration, Git workflows, and code review standards.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-white border border-parchment-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
              <h3 class="font-serif font-bold text-base text-charcoal-950">
                PixelCompute — Selected Training Program
              </h3>
              <span class="text-xs font-mono text-charcoal-500">
                Skill Development
              </span>
            </div>
            <p class="text-xs text-charcoal-600 leading-relaxed">
              Selected for the PixelCompute training program, focusing on strengthening programming fundamentals, algorithms, and practical problem-solving capabilities.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-white border border-parchment-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
              <h3 class="font-serif font-bold text-base text-charcoal-950">
                Virtual Learning &amp; Internship Programs
              </h3>
              <span class="text-xs font-mono text-charcoal-500">
                Edunet &bull; 1M1B &bull; Infosys Springboard
              </span>
            </div>
            <p class="text-xs text-charcoal-600 leading-relaxed">
              Participated in structured virtual learning and internship programs organized through Edunet, 1M1B, and Infosys Springboard, developing industry knowledge in AI fundamentals and sustainable development.
            </p>
          </div>
        </div>
      </section>

      <!-- 6. Certifications & Highlights -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">06</span>
          Certifications &amp; Learning Highlights
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="p-4 rounded-lg bg-white border border-parchment-300 flex items-start gap-2.5">
            <span class="text-terracotta-600 font-bold font-mono">01</span>
            <div>
              <p class="font-semibold text-charcoal-900 font-sans">NPTEL — Python for Data Science</p>
              <p class="text-charcoal-500 font-mono">Elite + Silver (82%, Top 5% of candidates)</p>
            </div>
          </div>

          <div class="p-4 rounded-lg bg-white border border-parchment-300 flex items-start gap-2.5">
            <span class="text-terracotta-600 font-bold font-mono">02</span>
            <div>
              <p class="font-semibold text-charcoal-900 font-sans">Oracle Cloud Infrastructure (OCI)</p>
              <p class="text-charcoal-500 font-mono">AI Foundations Associate</p>
            </div>
          </div>

          <div class="p-4 rounded-lg bg-white border border-parchment-300 flex items-start gap-2.5">
            <span class="text-terracotta-600 font-bold font-mono">03</span>
            <div>
              <p class="font-semibold text-charcoal-900 font-sans">WISER — Quantum Fundamentals</p>
              <p class="text-charcoal-500 font-mono">Certified Program</p>
            </div>
          </div>

          <div class="p-4 rounded-lg bg-white border border-parchment-300 flex items-start gap-2.5">
            <span class="text-terracotta-600 font-bold font-mono">04</span>
            <div>
              <p class="font-semibold text-charcoal-900 font-sans">IBM — AI Fundamentals</p>
              <p class="text-charcoal-500 font-mono">Foundational Knowledge Badge</p>
            </div>
          </div>

          <div class="p-4 rounded-lg bg-white border border-parchment-300 flex items-start gap-2.5">
            <span class="text-terracotta-600 font-bold font-mono">05</span>
            <div>
              <p class="font-semibold text-charcoal-900 font-sans">IBM — DevOps, Agile &amp; Design Thinking</p>
              <p class="text-charcoal-500 font-mono">Methodology &amp; Practices</p>
            </div>
          </div>

          <div class="p-4 rounded-lg bg-white border border-parchment-300 flex items-start gap-2.5">
            <span class="text-terracotta-600 font-bold font-mono">06</span>
            <div>
              <p class="font-semibold text-charcoal-900 font-sans">Wadhwani Ignite India</p>
              <p class="text-charcoal-500 font-mono">Certified Practice Venture</p>
            </div>
          </div>

          <div class="p-4 rounded-lg bg-white border border-parchment-300 flex items-start gap-2.5 sm:col-span-2">
            <span class="text-terracotta-600 font-bold font-mono">07</span>
            <div>
              <p class="font-semibold text-charcoal-900 font-sans">1M1B — AI for Sustainability</p>
              <p class="text-charcoal-500 font-mono">Global Program Certification</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 7. Why I Write -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4 pb-2 border-b border-parchment-200 flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-parchment-200 text-charcoal-700">07</span>
          Why I Write
        </h2>
        <div class="prose prose-charcoal max-w-none text-charcoal-700 leading-relaxed space-y-4">
          <blockquote>
            "Writing about what you learn turns passive consumption into active mastery."
          </blockquote>
          <p>
            I write because explaining concepts clearly is the most rigorous test of my own understanding. In coursework and side projects, it is easy to assume you understand a framework or algorithm until you sit down to articulate the underlying mechanics, tradeoffs, and edge cases.
          </p>
          <p>
            This website serves as my public notebook. Here, I break down complex computer science ideas, document bugs and breakthroughs from my projects, and build a lasting archive of my growth as an engineer.
          </p>
        </div>
      </section>

      <!-- 8. Connect & Social Links -->
      <section class="pt-6 border-t border-parchment-200">
        <h2 class="font-serif text-2xl font-bold text-charcoal-950 mb-4">
          Connect &amp; Say Hello
        </h2>
        <p class="text-sm text-charcoal-600 mb-6 leading-relaxed">
          I am always open to discussing new ideas, collaborative projects, or constructive feedback. Feel free to connect across any of these channels:
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 rounded-xl bg-white border border-parchment-300 hover:border-terracotta-300 text-sm font-medium text-charcoal-800 hover:text-terracotta-700 transition-all flex items-center gap-2.5 shadow-2xs"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            GitHub
          </a>

          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 rounded-xl bg-white border border-parchment-300 hover:border-terracotta-300 text-sm font-medium text-charcoal-800 hover:text-terracotta-700 transition-all flex items-center gap-2.5 shadow-2xs"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn
          </a>

          <a
            href={`mailto:${siteConfig.author.email}`}
