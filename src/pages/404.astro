---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found"
  description="The publication or page you are looking for does not exist or has been relocated."
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-24 sm:py-32 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-parchment-200 border border-parchment-300 text-xs font-mono font-bold tracking-widest uppercase text-terracotta-700 mb-6">
      404 Error &bull; Missing Record
    </div>

    <h1 class="font-serif text-5xl sm:text-6xl font-bold tracking-tight text-charcoal-950 mb-4">
      Page Not Found
    </h1>

    <p class="text-base sm:text-lg text-charcoal-600 font-sans leading-relaxed mb-8 max-w-md mx-auto">
      The essay or page you requested could not be located in the journal archives. It may have been renamed, relocated, or is still being drafted.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="px-5 py-2.5 rounded-lg bg-charcoal-900 hover:bg-terracotta-600 text-parchment-50 text-xs font-semibold tracking-wide transition-colors shadow-2xs"
      >
        Return to Homepage &rarr;
      </a>

      <a
        href="/blogs"
        class="px-5 py-2.5 rounded-lg bg-white border border-parchment-300 hover:bg-parchment-100 text-charcoal-700 text-xs font-medium transition-colors"
      >
        Browse All Articles
      </a>
    </div>
  </div>
</BaseLayout>
