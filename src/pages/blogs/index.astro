---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import { getAllBlogs, getAllCategories, getAllTags } from '@utils/content';

const allPosts = await getAllBlogs();
const categories = await getAllCategories();
const allTags = await getAllTags();
---

<BaseLayout
  title="All Articles — Technical Publication"
  description="Browse every article, technical synthesis, and learning retrospective published on Chronicles & Code."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    <!-- Page Header -->
    <header class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-charcoal-700 mb-3">
        <span class="w-2 h-2 rounded-full bg-terracotta-600"></span>
        The Complete Archive
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-charcoal-950 mb-4">
        All Publications
      </h1>
      <p class="text-lg text-charcoal-600 font-sans leading-relaxed">
        Every technical essay, code breakdown, architecture breakdown, and weekly retrospective in reverse chronological order. Filter by category, search by keyword, or explore tags below.
      </p>
    </header>

    <!-- Interactive Filter Controls Bar -->
    <div class="p-6 rounded-2xl bg-white border border-parchment-300 shadow-2xs mb-10 space-y-6">
      <!-- Search Input -->
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-charcoal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input
          type="text"
          id="archive-search-input"
          placeholder="Filter by title, description, or keyword..."
          class="w-full pl-11 pr-4 py-3 rounded-xl border border-parchment-300 bg-parchment-50 text-charcoal-900 placeholder-charcoal-400 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta-500 focus:bg-white transition-all font-sans"
        />
      </div>

      <!-- Categories Filter Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
        <span class="text-xs font-mono text-charcoal-500 uppercase tracking-wider shrink-0 mr-1">
          Category:
        </span>
        <button
          type="button"
          class="category-filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium border border-parchment-300 bg-charcoal-900 text-parchment-50 transition-all shrink-0 cursor-pointer"
          data-category="all"
        >
          All ({allPosts.length})
        </button>
        {
          categories.map((cat) => (
            <button
              type="button"
              class="category-filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium border border-parchment-300 bg-white text-charcoal-700 hover:border-terracotta-300 hover:text-terracotta-700 transition-all shrink-0 cursor-pointer"
              data-category={cat.name}
            >
              {cat.name} ({cat.count})
            </button>
          ))
        }
      </div>

      <!-- Tag Filter Pills -->
      <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-parchment-200 text-xs">
        <span class="font-mono text-charcoal-500 uppercase tracking-wider text-[11px] mr-2">
          Popular Tags:
        </span>
        {
          allTags.slice(0, 8).map((t) => (
            <button
              type="button"
              class="tag-filter-btn px-2.5 py-0.5 rounded bg-parchment-100 hover:bg-parchment-200 border border-parchment-200 text-charcoal-600 transition-colors font-mono cursor-pointer"
              data-tag={t.name}
            >
              #{t.name}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Active Filters & Results Summary -->
    <div class="flex items-center justify-between text-xs font-mono text-charcoal-500 mb-6">
      <span id="results-count-label">
        Showing {allPosts.length} of {allPosts.length} articles
      </span>

      <button
        type="button"
        id="reset-filters-btn"
        class="hidden text-terracotta-600 hover:underline cursor-pointer"
      >
        Clear filters &times;
      </button>
    </div>

    <!-- Articles Grid -->
    <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allPosts.map((post) => (
        <div
          class="article-grid-item"
          data-title={post.data.title.toLowerCase()}
          data-description={post.data.description.toLowerCase()}
          data-category={post.data.category}
          data-tags={post.data.tags.join(',').toLowerCase()}
        >
          <PostCard post={post} />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div
      id="archive-empty-state"
      class="hidden py-16 px-4 text-center rounded-2xl bg-parchment-100 border border-dashed border-parchment-300 my-8"
    >
      <div class="w-12 h-12 rounded-full bg-parchment-200 text-charcoal-600 flex items-center justify-center mx-auto mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <h3 class="font-serif text-xl font-bold text-charcoal-900 mb-1">
        No articles match your criteria
      </h3>
      <p class="text-xs text-charcoal-600 max-w-sm mx-auto mb-4">
        Try clearing your search term or switching to another category.
      </p>
      <button
        type="button"
        id="empty-reset-btn"
        class="px-4 py-2 rounded-lg bg-charcoal-900 hover:bg-terracotta-600 text-parchment-50 text-xs font-semibold transition-colors"
      >
        Reset Filters
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  function setupArchiveFilters() {
    const searchInput = document.getElementById('archive-search-input') as HTMLInputElement | null;
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.category-filter-btn');
    const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.article-grid-item');
    const countLabel = document.getElementById('results-count-label');
    const emptyState = document.getElementById('archive-empty-state');
    const resetBtn = document.getElementById('reset-filters-btn');
    const emptyResetBtn = document.getElementById('empty-reset-btn');

    let currentCategory = 'all';
    let currentTag = '';
    let currentQuery = '';

    function filterArticles() {
      let visibleCount = 0;
      const totalCount = items.length;

      items.forEach((item) => {
        const title = item.dataset.title || '';
        const desc = item.dataset.description || '';
        const cat = item.dataset.category || '';
        const tags = item.dataset.tags || '';

        const matchesCat = currentCategory === 'all' || cat.toLowerCase() === currentCategory.toLowerCase();
        const matchesTag = !currentTag || tags.includes(currentTag.toLowerCase());
        const matchesQuery =
          !currentQuery ||
          title.includes(currentQuery) ||
          desc.includes(currentQuery) ||
          cat.toLowerCase().includes(currentQuery) ||
          tags.includes(currentQuery);

        if (matchesCat && matchesTag && matchesQuery) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (countLabel) {
        countLabel.textContent = `Showing ${visibleCount} of ${totalCount} articles`;
      }

      const hasActiveFilters = currentCategory !== 'all' || currentTag !== '' || currentQuery !== '';

      if (resetBtn) {
        if (hasActiveFilters) {
          resetBtn.classList.remove('hidden');
        } else {
          resetBtn.classList.add('hidden');
        }
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', () => {
      currentQuery = searchInput.value.trim().toLowerCase();
      filterArticles();
    });

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach((b) => {
          b.classList.remove('bg-charcoal-900', 'text-parchment-50');
          b.classList.add('bg-white', 'text-charcoal-700');
        });
        btn.classList.add('bg-charcoal-900', 'text-parchment-50');
        btn.classList.remove('bg-white', 'text-charcoal-700');

        currentCategory = btn.dataset.category || 'all';
        filterArticles();
      });
    });

    tagButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag || '';
        if (currentTag === tag) {
          currentTag = '';
          btn.classList.remove('bg-terracotta-600', 'text-white', 'border-terracotta-600');
          btn.classList.add('bg-parchment-100', 'text-charcoal-600');
        } else {
          tagButtons.forEach((b) => {
            b.classList.remove('bg-terracotta-600', 'text-white', 'border-terracotta-600');
            b.classList.add('bg-parchment-100', 'text-charcoal-600');
          });
          btn.classList.add('bg-terracotta-600', 'text-white', 'border-terracotta-600');
          btn.classList.remove('bg-parchment-100', 'text-charcoal-600');
          currentTag = tag;
        }
        filterArticles();
      });
    });

    function resetFilters() {
      if (searchInput) searchInput.value = '';
      currentQuery = '';
      currentCategory = 'all';
      currentTag = '';

      catButtons.forEach((b, idx) => {
        if (idx === 0) {
          b.classList.add('bg-charcoal-900', 'text-parchment-50');
          b.classList.remove('bg-white', 'text-charcoal-700');
        } else {
          b.classList.remove('bg-charcoal-900', 'text-parchment-50');
          b.classList.add('bg-white', 'text-charcoal-700');
        }
      });

      tagButtons.forEach((b) => {
        b.classList.remove('bg-terracotta-600', 'text-white', 'border-terracotta-600');
        b.classList.add('bg-parchment-100', 'text-charcoal-600');
      });

      filterArticles();
    }

    resetBtn?.addEventListener('click', resetFilters);
    emptyResetBtn?.addEventListener('click', resetFilters);
  }

  setupArchiveFilters();
  document.addEventListener('astro:after-swap', setupArchiveFilters);
</script>
