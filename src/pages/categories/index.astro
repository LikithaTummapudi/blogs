---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getAllCategories } from '@utils/content';

const categories = await getAllCategories();
---

<BaseLayout
  title="Categories — Topics & Themes"
  description="Explore technical articles, computer science fundamentals, and engineering retrospectives organized by domain."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    <!-- Header -->
    <header class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-charcoal-700 mb-3">
        <span class="w-2 h-2 rounded-full bg-terracotta-600"></span>
        Taxonomy
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-charcoal-950 mb-4">
        Categories &amp; Themes
      </h1>
      <p class="text-lg text-charcoal-600 font-sans leading-relaxed">
        Articles are organized into distinct technical and reflective disciplines. Select a domain below to browse its dedicated publications.
      </p>
    </header>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        categories.map((cat) => (
          <a
            href={`/categories/${cat.slug}`}
            class="group p-8 rounded-2xl bg-white border border-parchment-300 hover:border-terracotta-300 transition-all duration-200 flex flex-col justify-between shadow-2xs hover:shadow-md h-full"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-parchment-100 text-charcoal-700 uppercase">
                  {cat.count} {cat.count === 1 ? 'Article' : 'Articles'}
                </span>
                <span class="text-charcoal-400 group-hover:text-terracotta-600 group-hover:translate-x-1 transition-all text-sm">
                  &rarr;
                </span>
              </div>

              <h2 class="font-serif text-2xl font-bold text-charcoal-950 group-hover:text-terracotta-700 transition-colors mb-3">
                {cat.name}
              </h2>

              <p class="text-sm text-charcoal-600 font-sans leading-relaxed">
                {cat.description}
              </p>
            </div>

            <div class="pt-6 border-t border-parchment-200 mt-6 flex items-center justify-between text-xs font-semibold text-terracotta-600">
              <span>View Articles in this Domain</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
