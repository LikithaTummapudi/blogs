---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import { getAllBlogs, getAllCategories, slugify, type PostWithMeta } from '@utils/content';
import { url } from '@utils/paths';

export async function getStaticPaths() {
  const categories = await getAllCategories();
  const allBlogs = await getAllBlogs();

  return categories.map((cat) => {
    const posts = allBlogs.filter(
      (blog) =>
        blog.data.category.toLowerCase() === cat.name.toLowerCase() ||
        slugify(blog.data.category) === cat.slug
    );

    return {
      params: { category: cat.slug },
      props: {
        category: cat,
        posts,
      },
    };
  });
}

interface Props {
  category: {
    name: string;
    slug: string;
    description: string;
    count: number;
    color: string;
  };
  posts: PostWithMeta[];
}

const { category, posts } = Astro.props;
---

<BaseLayout
  title={`${category.name} — Articles`}
  description={category.description}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex items-center gap-2 text-xs font-mono text-charcoal-500">
      <a href={url('/')} class="hover:text-charcoal-900">Home</a>
      <span>/</span>
      <a href={url('/categories')} class="hover:text-charcoal-900">Categories</a>
      <span>/</span>
      <span class="text-terracotta-700 font-semibold">{category.name}</span>
    </nav>

    <!-- Header -->
    <header class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-terracotta-700 bg-terracotta-50 border border-terracotta-200 px-3 py-1 rounded-full mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-terracotta-600"></span>
        Category Archive
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-charcoal-950 mb-4">
        {category.name}
      </h1>
      <p class="text-lg text-charcoal-600 font-sans leading-relaxed mb-4">
        {category.description}
      </p>
      <div class="text-xs font-mono text-charcoal-500">
        {posts.length} {posts.length === 1 ? 'article published' : 'articles published'} in this collection
      </div>
    </header>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>

    {
      posts.length === 0 && (
        <div class="py-16 text-center rounded-2xl bg-parchment-100 border border-dashed border-parchment-300">
          <p class="font-serif text-lg text-charcoal-700 mb-2">No articles in this category yet</p>
          <p class="text-xs text-charcoal-500 mb-6">Articles assigned to this category will automatically populate here.</p>
          <a
            href={url('/blogs')}
            class="px-4 py-2 rounded-lg bg-charcoal-900 text-parchment-50 text-xs font-semibold hover:bg-terracotta-600 transition-colors"
          >
            Browse All Blogs
          </a>
        </div>
      )
    }
  </div>
</BaseLayout>
