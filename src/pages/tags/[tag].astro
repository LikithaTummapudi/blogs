---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import { getAllBlogs, getAllTags, slugify, type PostWithMeta } from '@utils/content';
import { url } from '@utils/paths';

export async function getStaticPaths() {
  const tags = await getAllTags();
  const allBlogs = await getAllBlogs();

  return tags.map((t) => {
    const slug = slugify(t.name);
    const posts = allBlogs.filter((blog) =>
      blog.data.tags.some((tag) => slugify(tag) === slug || tag.toLowerCase() === t.name.toLowerCase())
    );

    return {
      params: { tag: slug },
      props: {
        tagName: t.name,
        posts,
      },
    };
  });
}

interface Props {
  tagName: string;
  posts: PostWithMeta[];
}

const { tagName, posts } = Astro.props;
---

<BaseLayout
  title={`Tag: #${tagName} — Publications`}
  description={`Articles tagged with #${tagName} on Chronicles & Code.`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex items-center gap-2 text-xs font-mono text-charcoal-500">
      <a href={url('/')} class="hover:text-charcoal-900">Home</a>
      <span>/</span>
      <a href={url('/blogs')} class="hover:text-charcoal-900">Articles</a>
      <span>/</span>
      <span class="text-terracotta-700 font-semibold">#{tagName}</span>
    </nav>

    <!-- Header -->
    <header class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-charcoal-700 mb-3">
        <span class="w-2 h-2 rounded-full bg-terracotta-600"></span>
        Topic Tag Archive
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-charcoal-950 mb-4">
        #{tagName}
      </h1>
      <p class="text-base text-charcoal-600 font-sans leading-relaxed">
        Showing all {posts.length} {posts.length === 1 ? 'publication' : 'publications'} tagged with #{tagName}.
      </p>
    </header>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
