---
import { siteConfig } from '@config/site';
import { url } from '@utils/paths';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="sticky top-0 z-40 w-full bg-parchment-50/90 backdrop-blur-md border-b border-parchment-200 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-18 py-4 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href={url('/')} class="group flex items-center gap-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-terracotta-500 rounded">
      <div class="w-8 h-8 rounded-lg bg-charcoal-900 flex items-center justify-center text-parchment-50 font-serif font-bold text-lg shadow-sm group-hover:bg-terracotta-600 transition-colors">
        C
      </div>
      <div class="flex flex-col">
        <span class="font-serif font-bold text-xl tracking-tight text-charcoal-950 group-hover:text-terracotta-700 transition-colors">
          {siteConfig.name}
        </span>
        <span class="text-[10px] uppercase tracking-widest text-charcoal-500 font-sans -mt-1">
          Technical Publication
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {
        siteConfig.nav.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`text-sm font-medium tracking-wide transition-colors duration-150 py-1 border-b-2 ${
                isActive
                  ? 'text-charcoal-950 border-terracotta-500 font-semibold'
                  : 'text-charcoal-600 border-transparent hover:text-charcoal-900 hover:border-parchment-300'
              }`}
            >
              {item.title}
            </a>
          );
        })
      }
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <!-- Search Button Trigger -->
      <button
        type="button"
        id="search-trigger-btn"
        aria-label="Search articles"
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-parchment-300 bg-parchment-100 hover:bg-parchment-200 text-charcoal-600 hover:text-charcoal-900 transition-all text-sm group cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-terracotta-500"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-charcoal-500 group-hover:text-terracotta-600 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="hidden sm:inline text-xs text-charcoal-500">Search</span>
        <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono text-charcoal-500 bg-white border border-parchment-300 rounded shadow-2xs">
          Ctrl K
        </kbd>
      </button>

      <!-- Newsletter Button -->
      <button
        type="button"
        id="newsletter-trigger-btn"
        class="hidden sm:inline-flex items-center justify-center px-3.5 py-1.5 rounded-lg bg-charcoal-900 hover:bg-terracotta-600 text-parchment-50 text-xs font-medium tracking-wide transition-colors duration-150 shadow-2xs cursor-pointer"
      >
        Subscribe
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        class="md:hidden p-2 rounded-lg text-charcoal-700 hover:bg-parchment-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-terracotta-500 cursor-pointer"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</header>
