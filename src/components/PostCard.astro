---
import type { PostWithMeta } from '@utils/content';
import { formatDate } from '@utils/content';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  post: PostWithMeta;
}

const { post } = Astro.props;
---

<article class="group flex flex-col rounded-xl bg-white border border-parchment-300 hover:border-terracotta-300 transition-all duration-200 overflow-hidden shadow-2xs hover:shadow-md h-full">
  <!-- Cover Image Link -->
  <a href={`/blogs/${post.slug}`} class="block relative aspect-16/9 overflow-hidden bg-charcoal-900">
    <img
      src={post.data.coverImage}
      alt={post.data.coverAlt || post.data.title}
      class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300"
      loading="lazy"
    />
    {
      post.data.draft && (
        <span class="absolute top-3 right-3 px-2 py-0.5 rounded text-[10px] font-mono uppercase font-bold bg-amber-500 text-charcoal-950 shadow-sm">
          DRAFT
        </span>
      )
    }
  </a>

  <!-- Card Body -->
  <div class="p-6 flex flex-col flex-1 justify-between">
    <div>
      <!-- Category & Meta -->
      <div class="flex items-center justify-between gap-2 mb-3">
        <CategoryBadge category={post.data.category} size="sm" />
        <span class="text-xs font-mono text-terracotta-700 font-medium">
          {post.readingTime}
        </span>
      </div>

      <!-- Title -->
      <h3 class="font-serif text-xl font-bold text-charcoal-950 group-hover:text-terracotta-700 transition-colors leading-snug mb-2.5">
        <a href={`/blogs/${post.slug}`} class="focus:outline-none">
          {post.data.title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-charcoal-600 font-sans text-sm leading-relaxed line-clamp-3 mb-4">
        {post.data.description}
      </p>
    </div>

    <!-- Footer metadata & Tags -->
    <div class="pt-4 border-t border-parchment-200 mt-2 flex flex-col gap-3">
      <div class="flex flex-wrap gap-1.5">
        {
          post.data.tags.slice(0, 3).map((tag) => (
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-parchment-100 text-charcoal-600">
              #{tag}
            </span>
          ))
        }
      </div>

      <div class="flex items-center justify-between text-xs text-charcoal-500 font-mono">
        <span>{formatDate(post.data.pubDate)}</span>
        <span class="font-sans font-medium text-terracotta-600 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
          Read &rarr;
        </span>
      </div>
    </div>
  </div>
</article>
