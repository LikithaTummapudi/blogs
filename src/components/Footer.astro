---
import { siteConfig } from '@config/site';
import { url } from '@utils/paths';

const currentYear = new Date().getFullYear();
---

<footer class="mt-24 border-t border-parchment-200 bg-parchment-100/60 pt-16 pb-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-parchment-200">
      <!-- Col 1: Brand & Tagline -->
      <div class="md:col-span-5 flex flex-col gap-3">
        <a href={url('/')} class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-md bg-charcoal-900 text-parchment-50 font-serif font-bold text-sm flex items-center justify-center">
            C
          </div>
          <span class="font-serif font-bold text-lg text-charcoal-950">
            {siteConfig.name}
          </span>
        </a>
        <p class="text-sm text-charcoal-600 max-w-sm leading-relaxed mt-1">
          {siteConfig.tagline}. An editorial journal by {siteConfig.author.name} dedicated to technical clarity, systems exploration, and disciplined learning.
        </p>
        <div class="flex items-center gap-2 mt-2">
          <span class="inline-block w-2 h-2 rounded-full bg-sage-500"></span>
          <span class="text-xs text-charcoal-500 font-mono">Personal Knowledge Journal</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="md:col-span-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-charcoal-900 mb-4 font-mono">
          Navigation
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            siteConfig.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-charcoal-600 hover:text-terracotta-600 transition-colors inline-block"
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Categories -->
      <div class="md:col-span-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-charcoal-900 mb-4 font-mono">
          Topics
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            siteConfig.categories.slice(0, 5).map((cat) => (
              <li>
                <a
                  href={url(`/categories/${cat.slug}`)}
                  class="text-charcoal-600 hover:text-terracotta-600 transition-colors inline-block"
                >
                  {cat.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 4: Connect / Social -->
      <div class="md:col-span-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-charcoal-900 mb-4 font-mono">
          Connect
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-charcoal-600 hover:text-terracotta-600 transition-colors inline-flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              GitHub
            </a>
          </li>
          <li>
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-charcoal-600 hover:text-terracotta-600 transition-colors inline-flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href={`mailto:${siteConfig.author.email}`}
              class="text-charcoal-600 hover:text-terracotta-600 transition-colors inline-flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Email
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-charcoal-500 gap-4">
      <p>
        &copy; {currentYear} {siteConfig.name}. Written by {siteConfig.author.name}. All rights reserved.
      </p>
      <p class="text-charcoal-400 font-mono">
        Built with Astro & TypeScript &bull; Statically Pre-rendered
      </p>
    </div>
  </div>
</footer>
