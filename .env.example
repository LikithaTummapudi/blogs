# ==============================================================================
# Chronicles & Code — Environment Configuration
# ==============================================================================
# Copy this file to `.env` for local development.
# On Vercel, configure these key-value pairs in:
# Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site URL
# ------------------------------------------------------------------------------
# Used for absolute URLs in email newsletters, unsubscribe links, and OAuth redirects.
# Local: http://localhost:4321
# Production: https://your-production-domain.vercel.app
SITE_URL=http://localhost:4321

# ------------------------------------------------------------------------------
# 2. Admin Authentication & Session Security (GitHub OAuth)
# ------------------------------------------------------------------------------
# Create a GitHub OAuth App at: https://github.com/settings/developers
# - Application name: Chronicles & Code Admin
# - Homepage URL: http://localhost:4321 (or your production Vercel URL)
# - Authorization callback URL: http://localhost:4321/api/auth/callback
#   (In production: https://your-domain.vercel.app/api/auth/callback)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# The only GitHub username permitted to log into /admin.
ADMIN_USERNAME=LikithaTummapudi

# A secure random 32+ character string used to sign HTTP-only session cookies.
# Generate one via: openssl rand -base64 32
SESSION_SECRET=generate_a_random_32_character_secret_key_here

# ------------------------------------------------------------------------------
# 3. GitHub Contents API (Remote Markdown & Image Commit Engine)
# ------------------------------------------------------------------------------
# When writing articles from the /admin portal, articles (.md) and uploaded images
# are committed directly to your GitHub repository using GitHub's Contents API.
GITHUB_REPO_OWNER=LikithaTummapudi
GITHUB_REPO_NAME=blogs
GITHUB_BRANCH=main

# Optional: A GitHub Personal Access Token (PAT) with `repo` scope.
# If omitted, the admin's GitHub OAuth token acquired upon login is used automatically.
# In local development mode, content is also saved directly to the local disk!
GITHUB_TOKEN=ghp_optional_personal_access_token_with_repo_scope

# ------------------------------------------------------------------------------
# 4. Supabase (Database for Email Subscribers)
# ------------------------------------------------------------------------------
# Create a free project at https://supabase.com
# Find these values in: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role key to bypass RLS for subscriber inserts and unsubscribes:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Alternatively, anon key if service role is not preferred:
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase SQL Schema Required:
# Run this SQL in your Supabase SQL Editor:
#
#   create table if not exists subscribers (
#     id uuid default gen_random_uuid() primary key,
#     email text unique not null,
#     created_at timestamp with time zone default timezone('utc'::text, now()) not null,
#     status text default 'active' not null check (status in ('active', 'unsubscribed')),
#     token text unique not null,
#     updated_at timestamp with time zone default timezone('utc'::text, now())
#   );
#
#   create table if not exists sent_notifications (
#     id uuid default gen_random_uuid() primary key,
#     article_slug text not null,
#     sent_at timestamp with time zone default timezone('utc'::text, now()) not null,
#     recipient_count integer not null default 0
#   );
#
#   create index if not exists idx_subscribers_email on subscribers(email);
#   create index if not exists idx_subscribers_token on subscribers(token);
#   create index if not exists idx_sent_notifications_slug on sent_notifications(article_slug);

# ------------------------------------------------------------------------------
# 5. Resend (Transactional & Broadcast Email Engine)
# ------------------------------------------------------------------------------
# Create a free account at https://resend.com
# Create an API Key under: API Keys -> Create API Key
RESEND_API_KEY=re_your_resend_api_key

# Sender address.
# For testing without a custom domain, you can use:
# EMAIL_FROM=Chronicles & Code <onboarding@resend.dev>
# For production with verified domain:
# EMAIL_FROM=Likitha Tummapudi <newsletter@yourdomain.com>
EMAIL_FROM="Likitha Tummapudi <onboarding@resend.dev>"
